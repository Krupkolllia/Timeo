# Copy for local development: cp .env.example .env
# In Cloudflare Pages the same variables are set in the project settings
# (Settings → Environment variables), not in a file — .env doesn't get deployed there.
# Needed from block 7 ("Cloud") onward; before that the app works fully offline.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
