# Копия для локальной разработки: cp .env.example .env
# В Cloudflare Pages эти же переменные прописываются в настройках проекта
# (Settings → Environment variables), не в файле — .env туда не попадает.
# Нужны с блока 7 ("Облако"); до этого приложение работает полностью офлайн.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
